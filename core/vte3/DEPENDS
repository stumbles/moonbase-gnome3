depends gobject-introspection
depends vala
depends intltool
depends meson

depends gtk+-3

optional_depends icu4c \
                 "-D icu=true" \
                 "-D icu=false" \
                 "for ICU support"

optional_depends gnutls \
                 "-D gnutls=true" \
                 "-D gnutls=false" \
                 "for GNUTLS support"

optional_depends fribidi \
                 "-D fribidi=true" \
                 "-D fribidi=false" \
                 "for bidirectional text support"

optional_depends gtk-doc \
                 "-D docs=true" \
                 "-D docs=false" \
                 "for building documentation" \
                 "n"
